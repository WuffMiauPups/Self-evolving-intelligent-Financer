# SEIF / Alpaca environment
# Fill in only the two credentials below for normal paper trading.

ALPACA_API_KEY=
ALPACA_API_SECRET=

# Safe defaults
ALPACA_PAPER=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_FEED=iex

# Optional: switch only if you intentionally configure live mode in YAML
# ALPACA_PAPER=false
# ALPACA_BASE_URL=https://api.alpaca.markets
